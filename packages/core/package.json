{
  "name": "@fineprint/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./extract": "./src/extract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
