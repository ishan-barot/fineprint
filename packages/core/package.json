    "tokens": "tsx scripts/tokens-css.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}